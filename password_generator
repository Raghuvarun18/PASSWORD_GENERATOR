print("     @@@ PASSWORD GENERATOR @@@***     ")

import random   
import string    # imports all letters,digits,punctuation,etc...

things = string.ascii_letters + string.digits + string.punctuation
length = int(input("enter the lenght of the password :"))

if length <= 12:    # At most of the conditions paswword is always below 12 digits only .

    print("your password is :",end="")
    for password in range(0,length):
        password = random.choice(things)
        print(password,end="")
        
else:
    print("*** length should be below 12 or equal to 12 ***\a")
    
